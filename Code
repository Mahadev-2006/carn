        <div id="routeSteps" class="route-steps"></div>
      </div>

      <div id="civicSuggestion" style="margin-top:1rem;background:rgba(74,158,255,0.07);border:1px solid rgba(74,158,255,0.25);border-radius:10px;padding:1rem;font-size:13px">
