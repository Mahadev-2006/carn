function loadMatchRoute() {
  const pairId = document.getElementById('matchPairSelect').value;
  if(!pairId) { showAllPins(); return; }
  const pair = matchPairs.find(p => p.id===pairId);
  if(!pair || !mapInstance) return;

  // Strict Security Firewall: Only authorized participants of this match can view this route
  if (!currentUser || (!isSamePhone(pair.lostReporterPhone, currentUser.phone) && !isSamePhone(pair.foundReporterPhone, currentUser.phone))) {
    showToast('Unauthorized: Only the parties involved in this match can view this route.', 'error');
    clearRoute();
    return;
  }

  // Double check that it has been fully verified by both parties
  if (pair.status !== 'verified') {
    showToast('Route Locked: Awaiting full verification from both parties.', 'error');
    clearRoute();
    return;
  }

  const lostItem = items.find(i => i.id===pair.lostId);
  const foundItem = items.find(i => i.id===pair.foundId);
  if(!lostItem || !foundItem) return;

  routeLayerGroup.clearLayers();
  allMarkersGroup.clearLayers();

  // Use custom locations if they exist (provided via the location prompt modal)
  const lostLat = pair.customLostLat || lostItem.lat;
  const lostLng = pair.customLostLng || lostItem.lng;
  const foundLat = pair.customFoundLat || foundItem.lat;
  const foundLng = pair.customFoundLng || foundItem.lng;
  const lostLocName = pair.customLostLocName || lostItem.loc;
  const foundLocName = pair.customFoundLocName || foundItem.loc;

  const lostIcon = L.divIcon({ className:'', html:`<div style="background:#FF6B4A;color:white;border:2px solid white;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 3px 8px rgba(0,0,0,0.5)">🔴</div>`, iconSize:[30,30], iconAnchor:[15,15] });
  L.marker([lostLat, lostLng], {icon:lostIcon}).addTo(routeLayerGroup).bindPopup(`<b>🔴 LOST: ${lostItem.name}</b> (👤 ${lostItem.reporterName})<br/>📞 ${lostItem.reporterPhone}<br/><i>Location: ${lostLocName}</i>`).openPopup();

  const foundIcon = L.divIcon({ className:'', html:`<div style="background:#00C896;color:white;border:2px solid white;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 3px 8px rgba(0,0,0,0.5)">🟢</div>`, iconSize:[30,30], iconAnchor:[15,15] });
  L.marker([foundLat, foundLng], {icon:foundIcon}).addTo(routeLayerGroup).bindPopup(`<b>🟢 FOUND: ${foundItem.name}</b> (👤 ${foundItem.reporterName})<br/>📞 ${foundItem.reporterPhone}<br/><i>Location: ${foundLocName}</i>`);

  const civicIcon = L.divIcon({ className:'', html:`<div style="background:#FFB84A;color:#0A0F0D;border:2px solid white;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:15px;box-shadow:0 3px 8px rgba(0,0,0,0.5)">🏛</div>`, iconSize:[32,32], iconAnchor:[16,16] });
  L.marker([pair.civic.lat, pair.civic.lng], {icon:civicIcon}).addTo(routeLayerGroup).bindPopup(`<b>🏛 Meetup Point</b>`);

  const routeCoords = [[lostLat, lostLng], [pair.civic.lat, pair.civic.lng], [foundLat, foundLng]];
  L.polyline(routeCoords, { color:'#C084FC', weight:5, opacity:0.25, lineJoin:'round' }).addTo(routeLayerGroup);
  L.polyline(routeCoords, { color:'#C084FC', weight:3, opacity:0.9, dashArray:'10, 8', lineJoin:'round' }).addTo(routeLayerGroup);

  routeCoords.forEach((coord, i) => {
    if(i===0 || i===routeCoords.length-1) return;
    L.circleMarker(coord, { radius:6, color:'#C084FC', fillColor:'#C084FC', fillOpacity:0.9, weight:2 }).addTo(routeLayerGroup);
  });

  const distKm = haversineKm(lostLat, lostLng, foundLat, foundLng);
  const midLat = (lostLat + foundLat) / 2;
  const midLng = (lostLng + foundLng) / 2;
  const midIcon = L.divIcon({ className:'', html:`<div style="background:rgba(192,132,252,0.9);color:white;border:1px solid rgba(255,255,255,0.4);border-radius:20px;padding:4px 10px;font-size:11px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,0.4)">${distKm.toFixed(1)} km apart</div>`, iconSize:null, iconAnchor:null });
  L.marker([midLat, midLng], {icon:midIcon}).addTo(routeLayerGroup);

  mapInstance.fitBounds(L.latLngBounds(routeCoords).pad(0.25));

  document.getElementById('pairInfo').style.display = 'block';
  document.getElementById('matchBadge').style.display = 'block';
  document.getElementById('routeLostName').textContent = lostItem.name;
  document.getElementById('routeLostLoc').textContent = `📍 ${lostLocName} (👤 ${lostItem.reporterName} - 📞 ${lostItem.reporterPhone})`;
  document.getElementById('routeFoundName').textContent = foundItem.name;
  document.getElementById('routeFoundLoc').textContent = `📍 ${foundLocName} (👤 ${foundItem.reporterName} - 📞 ${foundItem.reporterPhone})`;
  
  const walkMin = Math.round(distKm * 12);
  const driveMin = Math.round(distKm * 3);
  document.getElementById('routeStats').innerHTML = `
    <div class="route-stat"><div class="route-stat-val">${distKm.toFixed(1)} km</div><div class="route-stat-lbl">Total distance</div></div>
    <div class="route-stat"><div class="route-stat-val">${driveMin} min</div><div class="route-stat-lbl">By auto/car</div></div>
    <div class="route-stat"><div class="route-stat-val">${walkMin} min</div><div class="route-stat-lbl">Walking</div></div>
    <div class="route-stat"><div class="route-stat-val" style="color:var(--accent)">${pair.score}%</div><div class="route-stat-lbl">Match confidence</div></div>`;

  document.getElementById('routeSteps').innerHTML = pair.steps.map((s,i) => `<div class="route-step-item"><div class="route-step-num">${i+1}</div><div>${s}</div></div>`).join('');
  document.getElementById('civicName').textContent = pair.civic.name || 'Generated Midpoint Safehouse';
  document.getElementById('civicAddr').textContent = pair.civic.addr || 'Coordinated Meeting Location';
}
function clearRoute() { document.getElementById('matchPairSelect').value = ''; document.getElementById('pairInfo').style.display = 'none'; document.getElementById('matchBadge').style.display = 'none'; showAllPins(); }
function haversineKm(lat1, lng1, lat2, lng2) { const R = 6371; const dLat = (lat2-lat1)*Math.PI/180; const dLng = (lng2-lng1)*Math.PI/180; const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2; return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); }

