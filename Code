    <!-- Ollama Settings Panel -->
    <div style="background: rgba(22,30,24,0.65); border: 1px solid var(--border); border-radius: 10px; padding: 10px 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; backdrop-filter: blur(8px); box-shadow: 0 4px 15px rgba(0,0,0,0.25);">
      <div style="display: flex; align-items: center; gap: 6px;">
        <span id="ollamaStatusDot" style="width: 8px; height: 8px; background: var(--danger); border-radius: 50%; display: inline-block;"></span>
        <span id="ollamaStatusText" style="font-size: 11.5px; font-weight: 700; color: var(--muted);">Ollama Offline</span>
      </div>
      <input type="text" id="ollamaUrl" value="http://localhost:11434" placeholder="Ollama URL" style="font-size: 11.5px; padding: 6px 10px; max-width: 140px; margin: 0; background: var(--surface);" onchange="checkOllamaConnection()" />
      <!-- Hidden Select to keep JS fully compatible -->
      <select id="ollamaModelSelect" style="display: none;">
        <option value="llama3.2:1b" selected>llama3.2:1b</option>
      </select>
      <!-- Premium visible badge -->
      <div style="font-size: 11px; font-weight: 700; background: rgba(0,200,150,0.1); border: 1px solid rgba(0,200,150,0.3); color: var(--accent); padding: 5px 12px; border-radius: 6px; font-family: monospace; letter-spacing: 0.5px; display: inline-flex; align-items: center; gap: 4px;">
        🤖 Model: llama3.2:1b
      </div>
      <button class="btn btn-outline" onclick="checkOllamaConnection()" style="font-size: 11px; padding: 6px 12px; margin: 0;">🔄 Connect</button>
    </div>
  </div>

  <div class="item-compare" id="fusionComparePanel">
    <div class="compare-card" id="fusionLostCard">
      <!-- Dynamically Populated -->
    </div>
    <div class="compare-card" id="fusionFoundCard">
      <!-- Dynamically Populated -->
    </div>
  </div>

  <!-- Ollama Analysis Logs (Terminal Style) -->
  <div id="ollamaLoaderPanel" style="display:none; background:rgba(10,15,13,0.9); border:1px solid var(--border); border-radius:var(--radius); padding:1.5rem; margin-bottom:1.5rem;">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
      <div class="pulse" style="background:var(--accent);"></div>
      <span style="font-family:var(--font-head); font-weight:700; font-size:13.5px; text-transform:uppercase; letter-spacing:0.5px; color:var(--accent);">Active LLM Fusion Pipeline</span>
    </div>
    <div class="progress-bar" style="width:100%; height:4px; margin-bottom:12px;"><div class="progress-fill" id="ollamaProgressBar" style="width:0%; background:var(--accent);"></div></div>
    <div class="mining-log-box" id="ollamaLogs" style="margin:0; max-height:150px;"></div>
  </div>

  <!-- Ollama Cognitive Insight Card -->
  <div id="ollamaInsightCard" style="display:none; background:linear-gradient(135deg, rgba(0,200,150,0.06), rgba(192,132,252,0.06)); border:1px solid rgba(192,132,252,0.3); border-radius:var(--radius); padding:1.5rem 2rem; margin-bottom:1.5rem; box-shadow:0 4px 20px rgba(192,132,252,0.15);">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="font-size:1.8rem;">🤖</span>
        <div>
          <h3 style="font-family:var(--font-head); font-size:1.15rem; font-weight:700; color:var(--text);" id="insightTitle">Ollama Cognitive Auditing Insights</h3>
          <p style="font-size:11.5px; color:var(--muted);" id="insightModelInfo">Powered by llama3 local execution</p>
        </div>
      </div>
      <button class="btn btn-primary" id="adoptWeightsBtn" onclick="adoptLLMWeights()" style="font-size:12px; padding:6px 14px;">🧠 Adopt Recommended Weights</button>
    </div>
    <p id="insightText" style="font-size:13.5px; color:var(--text); line-height:1.6; margin-bottom:1rem; border-left:3px solid var(--accent); padding-left:12px; font-style:italic;"></p>
    
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:10px; font-size:12px; background:rgba(0,0,0,0.2); padding:10px 14px; border-radius:8px; border:1px solid rgba(255,255,255,0.04);">
      <div><strong style="color:var(--muted);">Image Sim:</strong> <span style="font-family:monospace; color:var(--accent); font-weight:bold;" id="insightImg">--</span></div>
      <div><strong style="color:var(--muted);">Text Cosine:</strong> <span style="font-family:monospace; color:var(--info); font-weight:bold;" id="insightTxt">--</span></div>
      <div><strong style="color:var(--muted);">Loc Proximity:</strong> <span style="font-family:monospace; color:var(--warning); font-weight:bold;" id="insightLoc">--</span></div>
      <div><strong style="color:var(--muted);">Time Decays:</strong> <span style="font-family:monospace; color:#C084FC; font-weight:bold;" id="insightTime">--</span></div>
      <div><strong style="color:var(--muted);">Meta Overlap:</strong> <span style="font-family:monospace; color:var(--danger); font-weight:bold;" id="insightMeta">--</span></div>
    </div>
  </div>

  <div class="section-title" style="margin-bottom:1rem">Signal <span>Breakdown</span></div>
  <div class="signal-grid" id="signalGrid"></div>

  <div class="section-title" style="margin-bottom:1rem">Fused <span>Confidence Score</span></div>
  <div class="fusion-result">
    <div class="fusion-donut">
      <svg width="120" height="120" viewBox="0 0 120 120">
        <circle class="donut-bg" cx="60" cy="60" r="48"/>
        <circle class="donut-fg" id="donutFg" cx="60" cy="60" r="48" stroke-dasharray="0 302"/>
      </svg>
      <div class="donut-label">
        <div class="donut-pct" id="donutPct">0%</div>
        <div class="donut-sub">confidence</div>
      </div>
    </div>
    <div class="fusion-detail">
      <h3 id="fusionVerdict">Calculating…</h3>
      <p id="fusionExplain" style="color:var(--muted);font-size:13px">Weighted signals are being fused together.</p>
      <div class="fusion-formula" id="fusionFormula">Final = Σ(signal × weight)</div>
      <div id="fusionLevel"></div>
    </div>
  </div>

  <div class="section-title" style="margin-bottom:1rem">Tune <span>Signal Weights</span></div>
  <div class="form-card" style="max-width:100%">
    <p style="font-size:13px;color:var(--muted);margin-bottom:1.2rem">Drag each slider to change how much each signal contributes. The final score updates live. Weights auto-normalise to 100%.</p>
    <div id="weightSliders"></div>
    <div class="divider" style="margin:1rem 0"></div>
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
      <span style="font-size:14px;color:var(--muted)">Recalculated confidence:</span>
      <span style="font-family:var(--font-head);font-size:1.8rem;font-weight:800;color:var(--accent)" id="liveScore">91%</span>
      <div id="liveBadge"></div>
    </div>
  </div>

  <div class="divider"></div>
  <div class="section-title" style="margin-bottom:1rem">How the <span>Formula Works</span></div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-bottom:2rem">
    <div class="signal-card"><div class="signal-icon">🖼️</div><div class="signal-name">Image similarity</div><div style="font-size:13px;color:var(--muted)">AI compares visual features — shape, colour histogram, edge patterns — using a CNN embedding model. Two identical items score 100%; different objects score near 0%.</div></div>
    <div class="signal-card"><div class="signal-icon">📝</div><div class="signal-name">Text / NLP similarity</div><div style="font-size:13px;color:var(--muted)">Descriptions are converted to sentence embeddings. Cosine similarity measures how semantically close "black phone with cracked screen" is to "dark smartphone".</div></div>
    <div class="signal-card"><div class="signal-icon">📍</div><div class="signal-name">Location proximity</div><div style="font-size:13px;color:var(--muted)">Haversine distance between GPS coordinates. Items within 500m score ~100%; score decays exponentially — at 5 km it's ~40%, at 20 km it's ~5%.</div></div>
    <div class="signal-card"><div class="signal-icon">⏱️</div><div class="signal-name">Time proximity</div><div style="font-size:13px;color:var(--muted)">Difference between lost and found timestamps. Same day = high score. Score drops over days. A 2-hour gap scores higher than a 2-week gap.</div></div>
    <div class="signal-card"><div class="signal-icon">🏷️</div><div class="signal-name">Metadata match</div><div style="font-size:13px;color:var(--muted)">Category, colour, brand, and size are structured fields. Exact category match gives a bonus. Colour mismatch applies a penalty to the final score.</div></div>
  </div>
</div>

<div class="modal-bg" id="loginModal">
  <div class="modal" style="max-width: 400px; text-align: center;">
    <div class="modal-header">
      <div class="modal-title">Secure Login</div>
      <button class="modal-close" onclick="closeModal('loginModal')">✕</button>
    </div>
    
    <div id="loginStep1">
      <p style="color:var(--muted); font-size:14px; margin-bottom:1rem;">Enter your name and verified municipal phone number to login or register.</p>
      <div class="form-group" style="text-align: left; margin-bottom:1rem;">
        <label>Full Name</label>
        <input type="text" id="loginName" placeholder="Your Name" />
      </div>
      <div class="form-group" style="text-align: left; margin-bottom:1.5rem;">
        <label>Phone Number</label>
        <input type="tel" id="loginPhone" placeholder="+91 98765 43210" />
      </div>
      <button class="btn btn-primary" style="width: 100%" onclick="sendOTP()">Send OTP Code</button>
    </div>

    <div id="loginStep2" style="display:none;">
      <p style="color:var(--muted); font-size:14px; margin-bottom:1rem;">Enter the 4-digit code sent to <span id="displayPhone" style="color:var(--text); font-weight:600;"></span>.</p>
      <div class="otp-inputs">
        <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp2')" id="otp1" />
        <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp3')" id="otp2" />
        <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp4')" id="otp3" />
        <input type="text" maxlength="1" class="otp-input" id="otp4" />
      </div>
      <button class="btn btn-primary" style="width: 100%; margin-top:1rem;" onclick="verifyOTP()">Verify OTP</button>
      <button class="btn btn-outline" style="width: 100%; margin-top:0.5rem; border:none;" onclick="resetLogin()">Back</button>
    </div>
  </div>
</div>
