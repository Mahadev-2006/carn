<script>
// ─── MULTI-TAB SYNC & DB STATE ────────────────────────────────────────────
function isSamePhone(p1, p2) {
  if (!p1 || !p2) return false;
  const s1 = String(p1);
  const s2 = String(p2);
  const c1 = s1.replace(/\D/g, '');
  const c2 = s2.replace(/\D/g, '');
  if (c1.length >= 10 && c2.length >= 10) {
    return c1.slice(-10) === c2.slice(-10); // Match last 10 digits
  }
  return c1 === c2;
}

function saveData() {
  localStorage.setItem('carn_users', JSON.stringify(usersDB));
  localStorage.setItem('carn_items', JSON.stringify(items));
  localStorage.setItem('carn_matches', JSON.stringify(matchPairs));
  localStorage.setItem('carn_blocks', JSON.stringify(ledgerBlocks));
  if(currentUser) sessionStorage.setItem('carn_currentUser', JSON.stringify(currentUser));
  else sessionStorage.removeItem('carn_currentUser');
}

let usersDB = JSON.parse(localStorage.getItem('carn_users')) || [];
let currentUser = JSON.parse(sessionStorage.getItem('carn_currentUser')) || null; 
let items = JSON.parse(localStorage.getItem('carn_items')) || [];
let matchPairs = JSON.parse(localStorage.getItem('carn_matches')) || [];
let ledgerBlocks = JSON.parse(localStorage.getItem('carn_blocks')) || [];

// Storage listener for cross-tab sync
window.addEventListener('storage', function(e) {
  const oldPairs = JSON.stringify(matchPairs);
  usersDB = JSON.parse(localStorage.getItem('carn_users')) || [];
  items = JSON.parse(localStorage.getItem('carn_items')) || [];
  matchPairs = JSON.parse(localStorage.getItem('carn_matches')) || [];
  ledgerBlocks = JSON.parse(localStorage.getItem('carn_blocks')) || [];
  
  if(currentUser) {
     const oldPairsParsed = JSON.parse(oldPairs || '[]');
     matchPairs.forEach(p => {
         const wasOld = oldPairsParsed.find(op => op.id === p.id);
         if(!wasOld && p.status === 'pending_claim') {
             if(isSamePhone(p.lostReporterPhone, currentUser.phone)) {
                 const fItem = items.find(i=>i.id === p.foundId);
                 if(fItem) showPendingClaimModal(p, fItem);
             } else if(isSamePhone(p.foundReporterPhone, currentUser.phone)) {
                 const lItem = items.find(i=>i.id === p.lostId);
                 if(lItem) showFinderWaitModal(p, lItem);
             }
         }
         if(wasOld && wasOld.status !== 'verified' && p.status === 'verified') {
             if(isSamePhone(p.lostReporterPhone, currentUser.phone) || isSamePhone(p.foundReporterPhone, currentUser.phone)) {
                 showVerifiedMatchModal(p);
             }
         }
     });
  }
  
  animateStats();
  renderRecent();
  if(document.getElementById('browse').classList.contains('active')) renderBrowse();
  if(document.getElementById('verify').classList.contains('active')) renderVerify();
  if(document.getElementById('map-page').classList.contains('active') && typeof showAllPins === 'function') {
      showAllPins();
      populateMatchSelect();
  }
});

let currentType = 'lost';
let mapInstance = null;
let browseTab = 'all';
let uploadDone = false;
let routeLayerGroup = null;
let allMarkersGroup = null;
let edgeAITags = [];
let pendingMatchPairIdToView = null;

const emojis = { Electronics:'📱', 'Bags & Wallets':'👜', Keys:'🔑', Clothing:'👕', Jewellery:'💎', Documents:'📄', Pets:'🐾', Other:'📦' };

// ─── UTILS / NOTIFICATIONS ──────────────────────────────────────────────────
function showToast(message, type = 'info') {
  const toast = document.getElementById('toast');
  toast.textContent = message;
  toast.className = 'toast show ' + type;
  setTimeout(() => toast.className = 'toast', 3000);
}

// ─── LOGIN & OTP AUTHENTICATION ────────────────────────────────────────────
function sendOTP() {
  const name = document.getElementById('loginName').value.trim();
  const phone = document.getElementById('loginPhone').value.trim();
  if(!name || !phone) { showToast('Please enter both Name and Phone number', 'error'); return; }
  
  document.getElementById('displayPhone').textContent = phone;
  document.getElementById('loginStep1').style.display = 'none';
  document.getElementById('loginStep2').style.display = 'block';
  setTimeout(()=> document.getElementById('otp1').focus(), 100);
}

function moveNext(curr, nextId) {
  if(curr.value.length >= 1) { document.getElementById(nextId).focus(); }
}

function verifyOTP() {
  // Prevent verification if full OTP is not provided
  const o1 = document.getElementById('otp1').value;
  const o2 = document.getElementById('otp2').value;
  const o3 = document.getElementById('otp3').value;
  const o4 = document.getElementById('otp4').value;
  
  if (!o1 || !o2 || !o3 || !o4) {
    showToast('Please enter the full 4-digit OTP', 'warning');
    return;
  }

  const name = document.getElementById('loginName').value.trim();
  const phone = document.getElementById('loginPhone').value.trim();
  
  // Extra safeguard
  if(!name || !phone) { 
     showToast('Session expired. Try again.', 'error');
     resetLogin();
     return; 
  }
  
  // Database check for exact phone match
  let existingUser = usersDB.find(u => isSamePhone(u.phone, phone));
  
  if (existingUser) {
    currentUser = existingUser;
    showToast(`✅ Welcome back, ${currentUser.name}!`, 'success');
  } else {
    currentUser = { name, phone };
    usersDB.push(currentUser);
    showToast(`✅ New Account created! Logged in as ${currentUser.name}.`, 'success');
  }
  saveData();

  // Update Navbar UI
  document.getElementById('loginBtn').style.display = 'none';
  document.getElementById('userNavGroup').classList.add('active');
  document.getElementById('navUserName').textContent = currentUser.name;
  
  closeModal('loginModal');
  goPage('home'); // Refresh view
}

function logout() {
  currentUser = null;
  saveData();
  document.getElementById('loginBtn').style.display = 'inline-block';
  document.getElementById('userNavGroup').classList.remove('active');
  showToast('🚪 Logged out successfully.', 'info');
  goPage('home');
}

function clearDatabase() {
  localStorage.removeItem('carn_users');
  localStorage.removeItem('carn_items');
  localStorage.removeItem('carn_matches');
  localStorage.removeItem('carn_blocks');
  sessionStorage.removeItem('carn_currentUser');
  usersDB = [];
  currentUser = null;
  items = [];
  matchPairs = [];
  ledgerBlocks = [];
  
  // Reset UI
  document.getElementById('loginBtn').style.display = 'inline-block';
  document.getElementById('userNavGroup').classList.remove('active');
  
  // Re-render views
