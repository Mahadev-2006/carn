        <div id="civicAddr" style="color:var(--muted);font-size:12px;margin-top:2px"></div>
      </div>
    </div>
  </div>

  <div id="map"></div>

  <div class="map-legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--danger)"></div> Lost Item Location</div>
