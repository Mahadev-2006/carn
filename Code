      <div class="item-card-meta"><span>📍 ${item.loc}</span><span style="color:var(--info)">👤 By ${item.reporterName}</span></div>
      ${aiTagsRender ? `<div style="margin-top:6px">${aiTagsRender}</div>` : ''}
      ${bar}
