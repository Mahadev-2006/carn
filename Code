    <!-- Ollama Settings Panel -->
    <div style="background: rgba(22,30,24,0.65); border: 1px solid var(--border); border-radius: 10px; padding: 10px 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; backdrop-filter: blur(8px); box-shadow: 0 4px 15px rgba(0,0,0,0.25);">
      <div style="display: flex; align-items: center; gap: 6px;">
        <span id="ollamaStatusDot" style="width: 8px; height: 8px; background: var(--danger); border-radius: 50%; display: inline-block;"></span>
        <span id="ollamaStatusText" style="font-size: 11.5px; font-weight: 700; color: var(--muted);">Ollama Offline</span>
