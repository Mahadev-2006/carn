function cardHTML(item) {
  const tagCls = { lost:'tag-lost', found:'tag-found', matched:'tag-matched' }[item.type];
  const tagLabel = { lost:'Lost', found:'Found', matched:'Matched ✓' }[item.type];
  const bar = item.score > 0 ? `<div class="match-score"><span style="color:var(--muted)">Match</span><div class="match-bar"><div class="match-bar-fill" style="width:${item.score}%;background:${item.score>85?'var(--accent)':item.score>60?'var(--warning)':'var(--danger)'}"></div></div><span style="color:var(--accent)">${item.score}%</span></div>` : '';
  const aiTagsRender = (item.aiTags || []).map(t => `<span class="tag tag-ai">${t}</span>`).join('');
  
  // Check if this item is part of a match pair
  const pair = matchPairs.find(p => p.lostId === item.id || p.foundId === item.id);
  let actionBtn = '';
  
  if (pair) {
    if (pair.status === 'pending_claim') {
      if (currentUser && isSamePhone(currentUser.phone, pair.lostReporterPhone)) {
        actionBtn = `<button class="btn btn-warning" style="margin-top:8px;font-size:12px;padding:5px 12px;width:100%" onclick="event.stopPropagation();openClaim(${pair.lostId})">❗ Verify Claim to Unlock</button>`;
      } else if (currentUser && isSamePhone(currentUser.phone, pair.foundReporterPhone)) {
        actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--warning);background:rgba(255,184,74,0.1);padding:5px;border-radius:6px;text-align:center">⏳ Waiting for Owner to Verify</div>`;
      } else {
        actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--muted);background:rgba(255,255,255,0.05);padding:5px;border-radius:6px;text-align:center">🔒 Private Match Found</div>`;
      }
    } else if (pair.status === 'pending_verification') {
      const isOwner = currentUser && isSamePhone(currentUser.phone, pair.lostReporterPhone);
      const isFinder = currentUser && isSamePhone(currentUser.phone, pair.foundReporterPhone);
      
      if (isOwner) {
        if (!pair.lostVerified) {
          actionBtn = `<button class="btn btn-warning" style="margin-top:8px;font-size:12px;padding:5px 12px;width:100%" onclick="event.stopPropagation(); goPage('verify'); setTimeout(() => openQuorumReview('${pair.id}'), 400);">🗳️ Review & Sign Verification</button>`;
        } else {
          actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--warning);background:rgba(255,184,74,0.1);padding:5px;border-radius:6px;text-align:center">⏳ Awaiting Finder's Verification Signature</div>`;
        }
      } else if (isFinder) {
        if (!pair.foundVerified) {
          actionBtn = `<button class="btn btn-warning" style="margin-top:8px;font-size:12px;padding:5px 12px;width:100%" onclick="event.stopPropagation(); goPage('verify'); setTimeout(() => openQuorumReview('${pair.id}'), 400);">🗳️ Review & Sign Verification</button>`;
        } else {
          actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--warning);background:rgba(255,184,74,0.1);padding:5px;border-radius:6px;text-align:center">⏳ Awaiting Owner's Verification Signature</div>`;
        }
      } else {
        actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--muted);background:rgba(255,255,255,0.05);padding:5px;border-radius:6px;text-align:center">🔒 Match Verification in Progress</div>`;
      }
    } else if (pair.status === 'verified') {
      if (currentUser && (isSamePhone(currentUser.phone, pair.lostReporterPhone) || isSamePhone(currentUser.phone, pair.foundReporterPhone))) {
        actionBtn = `<button class="btn btn-outline" style="margin-top:8px;font-size:12px;padding:5px 12px;width:100%" onclick="event.stopPropagation();viewRoute('${pair.id}')">🗺 View Route & Contact</button>`;
      } else {
        actionBtn = `<div style="margin-top:8px;font-size:12px;color:var(--accent);background:rgba(0,200,150,0.1);padding:5px;border-radius:6px;text-align:center">✅ Match Resolved & Verified</div>`;
      }
    }
  }

  return `<div class="item-card">
    <div class="item-card-img">${emojis[item.cat]||'📦'}</div>
    <div class="item-card-body">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <div class="item-card-title">${item.name}</div>
        <span class="tag ${tagCls}">${tagLabel}</span>
