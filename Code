        <span style="font-size: 10px; color: var(--muted);">${b.timestamp.split(',')[0]}</span>
      </div>
      <div class="chain-block-tx">${b.tx}</div>
      <div class="chain-block-hash" onclick="navigator.clipboard.writeText('${b.hash}'); showToast('📋 Hash copied to clipboard!', 'success');" title="Click to copy full hash">
        <span>${b.hash.slice(0, 8)}...${b.hash.slice(-6)}</span>
        <span style="font-size: 10px;">📋</span>
      </div>
    </div>`;
  }).join('');

  // Render Pending Quorum Validations Table
  const colours = { 
    verified: 'var(--accent)', 
    pending_verification: 'var(--warning)', 
    pending_claim: 'var(--info)' 
  };
  const labelTexts = {
    verified: 'Verified & Logged ✓',
    pending_verification: 'Awaiting Signatures 🗳️',
    pending_claim: 'Awaiting Questionnaire ⏳'
  };
  
  let tableHtml = '';
  
  if (!currentUser) {
    document.getElementById('quorumTableWrapper').innerHTML = `
      <div class="empty-state-shield">
        <div class="empty-state-icon">🔒</div>
        <div style="font-family:var(--font-head); font-weight:700; font-size:1.1rem; color:var(--text); margin-top:8px;">Authentication Required</div>
        <div style="font-size:13px; color:var(--muted); max-width:320px; margin:0 auto; margin-bottom: 12px;">Please log in to view or verify claims associated with your account.</div>
        <button class="btn btn-primary" onclick="openModal('loginModal')">🔒 Login Now</button>
      </div>`;
    return;
  }
  
  const myMatchPairs = matchPairs.filter(p => isSamePhone(p.lostReporterPhone, currentUser.phone) || isSamePhone(p.foundReporterPhone, currentUser.phone));
  
  myMatchPairs.forEach(p => {
    let lostItem = items.find(i => i.id === p.lostId);
    let itemLabel = lostItem ? lostItem.name : 'Unknown Item';
    let statusColor = colours[p.status] || 'var(--muted)';
    let statusLabel = labelTexts[p.status] || p.status;
    
    let actionHtml = '';
    
    if (p.status === 'pending_claim') {
      if (isSamePhone(currentUser.phone, p.lostReporterPhone)) {
        actionHtml = `<button class="review-btn" onclick="openClaim(${p.lostId})">📝 Answer Questionnaire</button>`;
      } else {
        actionHtml = `<span style="color:var(--warning); font-size:12px; font-weight:500;">⏳ Awaiting Owner's Answers</span>`;
      }
    } else if (p.status === 'pending_verification') {
      const isOwner = isSamePhone(currentUser.phone, p.lostReporterPhone);
      const isFinder = isSamePhone(currentUser.phone, p.foundReporterPhone);
      
      if (isOwner) {
        if (!p.lostVerified) {
          actionHtml = `<button class="review-btn" onclick="openQuorumReview('${p.id}')">🗳️ Review & Sign</button>`;
        } else {
          actionHtml = `<span style="color:var(--warning); font-size:12px; font-weight:500;">⏳ Awaiting Finder's Signature</span>`;
        }
      } else if (isFinder) {
        if (!p.foundVerified) {
          actionHtml = `<button class="review-btn" onclick="openQuorumReview('${p.id}')">🗳️ Review & Sign</button>`;
        } else {
          actionHtml = `<span style="color:var(--warning); font-size:12px; font-weight:500;">⏳ Awaiting Owner's Signature</span>`;
        }
      }
    } else if (p.status === 'verified') {
      actionHtml = `<button class="review-btn" style="background:rgba(74,158,255,0.1);color:var(--info);border-color:rgba(74,158,255,0.3);" onclick="viewRoute('${p.id}')">🗺️ View Route</button>`;
    }
    
    tableHtml += `<tr>
      <td style="font-family:monospace;font-size:12px;font-weight:600;">${p.id}</td>
      <td style="font-weight:500;">${p.label}</td>
      <td>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="match-bar" style="width:60px;margin-top:0;"><div class="match-bar-fill" style="width:${p.score}%;background:${p.score > 85 ? 'var(--accent)' : 'var(--warning)'}"></div></div>
          <span style="font-weight:700;color:var(--text);">${p.score}%</span>
        </div>
      </td>
      <td>
        <span class="tag" style="background:${statusColor}15;color:${statusColor};border:1px solid ${statusColor}33;padding: 3px 10px;margin-right:0;">
          ${statusLabel}
        </span>
      </td>
      <td style="font-size:12px;color:var(--muted)">Just now</td>
      <td style="text-align:right;">${actionHtml}</td>
    </tr>`;
  });
  
  if (tableHtml === '') {
    document.getElementById('quorumTableWrapper').innerHTML = `
      <div class="empty-state-shield">
        <div class="empty-state-icon">🛡️</div>
        <div style="font-family:var(--font-head); font-weight:700; font-size:1.1rem; color:var(--text); margin-top:8px;">P2P Claims Queue Secured</div>
        <div style="font-size:13px; color:var(--muted); max-width:320px; margin:0 auto;">There are no active pending match claims involving your registered phone number.</div>
      </div>`;
  } else {
    document.getElementById('quorumTableWrapper').innerHTML = `
      <div style="overflow-x:auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Claim ID</th>
               <th>Item Pair</th>
               <th>Confidence</th>
               <th>Current Status</th>
               <th>Timestamp</th>
               <th style="text-align:right;">Consensus Action</th>
            </tr>
          </thead>
          <tbody id="claimTable">${tableHtml}</tbody>
        </table>
      </div>`;
  }
}

