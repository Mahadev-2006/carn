    <div class="legend-item"><div class="legend-dot" style="background:var(--info)"></div> Matched</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--warning)"></div> Civic Drop Point</div>
    <div class="legend-item"><div class="legend-dot" style="background:#C084FC;border-radius:2px;width:20px;height:6px"></div> Route Line</div>
  </div>
</div>

